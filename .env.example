# Configuración de la conexión a MySQL de la aplicación Biblioteca.
# Copia este archivo como .env en la raíz del proyecto y cambia los valores.
# La aplicación solo lee estas tres variables (ver ConexionBD.java).
#
# Ruta A (MySQL en Docker):
#   DB_USER debe ser root, DB_PASS es la contraseña de root que tendrá el
#   contenedor y DB_URL se deja como está.
# Ruta B (MySQL instalado en Windows):
#   pon tu usuario y tu contraseña de MySQL, y DB_URL apuntando a tu servidor
#   y a la base de datos biblioteca (la que crea sql/init.sql).

# URL JDBC completa: servidor, puerto y base de datos
DB_URL=jdbc:mysql://localhost:3306/biblioteca

# Usuario de MySQL (en la Ruta A, siempre root)
DB_USER=root

# Contraseña de ese usuario (este valor es de ejemplo, pon la tuya)
DB_PASS=cambia_esta_clave
