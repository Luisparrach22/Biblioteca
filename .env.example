# Copiar como .env

# Ruta A (Docker): deja DB_URL y DB_USER así y pon en DB_PASS la contraseña
# que quieras, el contenedor la usará para root
DB_URL=jdbc:mysql://localhost:3306/biblioteca
DB_USER=root
DB_PASS=cambia_esta_clave

# Ruta B (MySQL instalado): cambia las 3 de arriba por las de tu MySQL, por ejemplo:
# DB_URL=jdbc:mysql://localhost:3306/biblioteca
# DB_USER=tu_usuario
# DB_PASS=tu_contraseña

# No se usan, todo va en DB_URL y DB_PASS
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biblioteca
DB_PASSWORD=cambia_esta_clave
